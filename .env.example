# Database Connection Settings
FITCORE_DB_HOST=localhost
FITCORE_DB_PORT=3306
FITCORE_DB_NAME=fitcore_pro
FITCORE_DB_USER=root
FITCORE_DB_PASSWORD=

# Connection Pool Settings
FITCORE_DB_MAX_POOL_SIZE=10
FITCORE_DB_MIN_IDLE=2
FITCORE_DB_TIMEOUT_MS=30000

# Application Settings
FITCORE_APP_TITLE=FitCore Pro - Fitness Management System
FITCORE_GYM_NAME=FitCore Pro Health & Fitness Club
FITCORE_GYM_ADDRESS=108 Fitness Boulevard, Suite 400, Metro City
FITCORE_GYM_PHONE=+1 (800) 555-CORE
FITCORE_GYM_EMAIL=support@fitcorepro.com
FITCORE_CURRENCY_SYMBOL=$
